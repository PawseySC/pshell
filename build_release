#!/bin/bash
set -e

echo "Building a zip bundle with version timestamp for release"

# stage the application and its dependencies outside the release directory
mkdir -p release
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT

cp release_main.py "$build_dir/__main__.py"
cp pshell.py "$build_dir/pshell.py"
cp parser.py mfclient.py s3client.py util.py "$build_dir/"

# stamp this release
d=$(date +%Y%m%d%H%M%S)
sed 's/^build.*$/build="'$d'"/' "$build_dir/pshell.py" > "$build_dir/pshell.stamped.py"
mv "$build_dir/pshell.stamped.py" "$build_dir/pshell.py"

# Include compatible dependency sets for Python 3.6-3.12 and Python 3.13+.
python3 -m pip install --disable-pip-version-check --no-compile \
    --python-version 3.6 --only-binary=:all: \
    --requirement requirements.txt --target "$build_dir/vendor/legacy"
python3 -m pip install --disable-pip-version-check --no-compile \
    --python-version 3.13 --only-binary=:all: \
    --requirement requirements.txt --target "$build_dir/vendor/modern"

# build
bundle=$(pwd)/release/pshell.zip
(cd "$build_dir" && zip -qr "$bundle" .)
{
    echo "#!/usr/bin/env python3"
    cat "$bundle"
} > release/pshell
chmod u+x release/pshell
rm "$bundle"

